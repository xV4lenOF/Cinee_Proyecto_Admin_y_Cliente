          <SubComponents>
            <Component class="javax.swing.JLabel" name="lblInfo">
              <Properties>
                <Property name="horizontalAlignment" type="int" value="0"/>
                <Property name="text" type="java.lang.String" value="&lt;html&gt;&lt;div style=&apos;text-align: center; font-family: Segoe UI, sans-serif; color: #94a3b8; font-size: 11px; font-weight: bold;&apos;&gt;Debido a la alta demanda de este estreno, el tiempo de espera puede ser ligeramente mayor.&lt;br&gt;Ten paciencia y mant&#xe9;n tu lugar en la fila.&lt;br&gt;&lt;br&gt;A&#xfa;n hay butacas disponibles. Recuerda que la disponibilidad de los mejores asientos&lt;br&gt;depende del stock al momento de que sea tu turno.&lt;br&gt;&lt;br&gt;&lt;span style=&apos;color: #cbd5e1;&apos;&gt;&lt;b&gt;\ud83d\udca1 Tip:&lt;/b&gt;&lt;/span&gt; Ten lista tu tarjeta de cr&#xe9;dito o d&#xe9;bito para realizar el pago m&#xe1;s r&#xe1;pido cuando ingreses.&lt;/div&gt;&lt;/html&gt;&#xa;" containsInvalidXMLChars="true"/>
              </Properties>
            </Component>
          </SubComponents>
